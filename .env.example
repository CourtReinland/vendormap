# Copy to .env. The demo runs without any of these set.

# Office login is created on first boot. Override before you share the demo.
OFFICE_EMAIL=office@newcenturyfestivals.com
OFFICE_PASSWORD=moon-demo-office

# Where the office copy of every booking email is addressed.
MAIL_TO_OFFICE=contact@newcenturyfestivals.com
MAIL_FROM="New Century Festivals <bookings@newcenturyfestivals.com>"

# Leave SMTP blank to keep emails in the on-screen outbox (no message is sent).
# Set these to deliver the vendor confirmation and the office copy for real.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Leave blank to use the demo pay button (no card is charged).
# A Stripe secret key turns on Checkout. Use a test key until go-live.
STRIPE_SECRET_KEY=
APP_URL=http://localhost:8787

PORT=8787
